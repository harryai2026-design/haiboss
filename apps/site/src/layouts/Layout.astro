---
import {site} from '@site/config'
import {organization,serializeJsonLd} from '@site/seo'
import '../styles/site.css'
import '../styles/experience.css'
const {title,description=site.description,business={}}=Astro.props
const base=Astro.site!.origin,canonical=new URL(Astro.url.pathname,base).href
const nav=[['/insights/','出海情报'],['/ai/','AI 动态'],['/guides/','实战指南'],['/services/','增长服务'],['/cases/','案例与方案']]
---
<!doctype html><html lang="zh-CN" style={`--accent:${site.theme.accent};--bg:${site.theme.background}`}>
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content="website"/><meta name="theme-color" content="#f7f7f2"/><link rel="icon" type="image/svg+xml" href="/brand.svg"/><link rel="alternate" type="application/rss+xml" title="海老板内容更新" href="/rss.xml"/>
{(process.env.SITE_ENVIRONMENT!=='production'||Astro.url.pathname.includes('404'))&&<meta name="robots" content="noindex, nofollow"/>}
<script type="application/ld+json" set:html={serializeJsonLd(organization({name:site.name,url:base,description:site.description,email:business.email,type:'Organization'}))}/><slot name="head"/></head>
<body data-site-release="ui-20261111"><a class="skip" href="#main">跳至正文</a><div class="topline"><div class="wrap"><span>HAIBOSS / 出海 · AI · 增长</span><div class="topline-actions"><button type="button" data-motion-toggle aria-pressed="false">暂停动效</button><a href="/rss.xml">订阅更新 ↗</a></div></div></div>
<header class="header wrap"><a class="brand" href="/" aria-label="海老板首页"><span class="brand-icon"><img src="/assets/haiboss-logo.png" width="37" height="37" alt="海老板品牌标识"/></span><span>海老板<small>HAIBOSS</small></span></a><button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">导航 ☰</button><nav id="site-nav" aria-label="主导航">{nav.map(([url,label])=><a href={url} aria-current={Astro.url.pathname.startsWith(url)?'page':undefined}>{label}</a>)}</nav><div class="header-actions"><a class="search-link" href="/search/">搜索 ⌕</a><a class="button compact" href="/contact/">聊聊增长 ↗</a></div></header>
<main id="main"><slot/></main>
<section class="footer-cta"><div class="wrap"><div><span class="eyebrow">FROM INSIGHT TO ACTION</span><h2>把看见的机会，<br/>变成下一步行动。</h2></div><a class="button light" href="/contact/">说说你正在解决的问题 ↗</a></div></section>
<footer class="wrap footer"><a class="brand" href="/">海老板 <small>HAIBOSS</small></a><p>行业信息提供判断依据，AI 方法进入真实业务。<br/>从一个产品、一个市场、一个问题开始。</p><div class="footer-links"><a href="/insights/">出海情报</a><a href="/ai/">AI 动态</a><a href="/guides/">实战指南</a><a href="/about/">关于海老板</a><a href="/privacy/">隐私说明</a><a href="/contact/">联系与咨询</a><a href="/rss.xml">RSS 订阅</a><a href="tel:18805065692">188 0506 5692</a>{business.email&&<a href={'mailto:'+business.email}>{business.email}</a>}</div><div class="copyright">© {new Date().getFullYear()} 海老板 · 出海情报与 AI 增长服务 <span>INSIGHT. EXPERIMENT. GROW.</span></div></footer>
<script>
 const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle'),nav=document.querySelector('#site-nav')
 const closeMenu=()=>{toggle?.setAttribute('aria-expanded','false');nav?.classList.remove('is-open')}
 toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));nav?.classList.toggle('is-open',open)})
 nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeMenu))
 addEventListener('keydown',e=>{if(e.key==='Escape'){const wasOpen=toggle?.getAttribute('aria-expanded')==='true';closeMenu();if(wasOpen)toggle?.focus()}})
 document.addEventListener('click',e=>{if(e.target instanceof Node&&!nav?.contains(e.target)&&!toggle?.contains(e.target))closeMenu()})
 const motion=document.querySelector<HTMLButtonElement>('[data-motion-toggle]'),preference=matchMedia('(prefers-reduced-motion: reduce)')
 let savedMotion:string|null=null;try{savedMotion=localStorage.getItem('haiboss-motion')}catch{}
 let paused=savedMotion?savedMotion==='off':preference.matches
 const applyMotion=()=>{document.documentElement.dataset.motion=paused?'off':'on';motion?.setAttribute('aria-pressed',String(paused));if(motion)motion.textContent=paused?'开启动效':'暂停动效'}
 applyMotion();motion?.addEventListener('click',()=>{paused=!paused;applyMotion();try{localStorage.setItem('haiboss-motion',paused?'off':'on')}catch{}})
 preference.addEventListener('change',()=>{paused=preference.matches;applyMotion()})
 if('IntersectionObserver'in window){const observer=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-revealed');observer.unobserve(entry.target)}})},{threshold:.08});document.querySelectorAll('.section-head,.intro-grid,.service-detail,.values-grid').forEach(el=>observer.observe(el))}
</script>
</body></html>
