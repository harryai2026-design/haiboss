---
import {sections,types} from '../lib/pages'
import {coverFor} from '../lib/visuals'
const {item,index=0}=Astro.props
const date=item.publishedAt?new Date(item.publishedAt).toLocaleDateString('zh-CN',{timeZone:'Asia/Shanghai'}):'编辑精选'
const cover=coverFor(item)
---
<article class={`article-card tone-${item.section||'guides'}`} data-content-type={item.contentType||'guide'}><a class="card-art" href={`/articles/${item.slug}/`} tabindex="-1" aria-hidden="true"><img src={cover.src} alt="" width="800" height="457" loading="lazy" decoding="async"/><span class="art-category">{sections[item.section]?.title||'实战指南'}</span><span class="art-arrow">↗</span><small>{cover.label}</small></a><div class="card-meta"><a href={`/${item.section||'guides'}/`}>{sections[item.section]?.title||'实战指南'}</a><span>{types[item.contentType]||'实战指南'}</span></div><h3><a href={`/articles/${item.slug}/`}>{item.title}</a></h3><p>{item.description}</p><div class="card-bottom"><time datetime={item.publishedAt}>{date}</time><a href={`/articles/${item.slug}/`} aria-label={`阅读：${item.title}`}>阅读全文 ↗</a></div></article>
