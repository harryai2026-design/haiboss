---
import Layout from '../layouts/Layout.astro'
import InquiryForm from '../components/InquiryForm.astro'
import ArticleCard from '../components/ArticleCard.astro'
import SceneImage from '../components/SceneImage.astro'
import WorkflowDemo from '../components/WorkflowDemo.astro'
import WorkflowFilm from '../components/WorkflowFilm.astro'
import PageExtras from '../components/PageExtras.astro'
import {buildPages,sections,types} from '../lib/pages'
import {coverFor,topicRoutes} from '../lib/visuals'
import {renderRichText} from '../../../../packages/content/richtext.mjs'
import {article,serializeJsonLd} from '@site/seo'
export async function getStaticPaths(){return(await buildPages()).map(page=>({params:{path:page.path.slice(1,-1)||undefined},props:page}))}
const page=Astro.props,{kind,doc,articles,topics,services,cases,business}=page
const listing=sections[kind]?articles.filter(x=>x.section===kind):kind==='topic'?articles.filter(x=>x.topics?.some(t=>(typeof t==='object'?t.id:t)===doc.id)):articles
const latest=[...articles].sort((a,b)=>new Date(b.publishedAt||0).getTime()-new Date(a.publishedAt||0).getTime())
const featured=articles.filter(x=>x.featured).slice(0,3),picks=featured.length?featured:latest.slice(0,3)
const plain=(node:any):string=>node?.text||node?.children?.map(plain).join('')||''
const date=(value:any)=>value?new Date(value).toLocaleDateString('zh-CN',{timeZone:'Asia/Shanghai'}):''
const headings=kind==='article'?(doc.content?.root?.children||[]).filter(n=>n.type==='heading').map(n=>plain(n)):[]
let html=kind==='article'?renderRichText(doc.content):'',headingIndex=0
html=html.replace(/<h([1-6])>/g,(_,n)=>'<h'+n+' id="section-'+headingIndex+++'">')
const schema=kind==='article'?article({title:doc.title,description:doc.description,url:new URL(page.path,Astro.site).href,publishedAt:doc.publishedAt,updatedAt:doc.updatedAt,author:doc.authorName||'海老板编辑部',locale:'zh'}):null
const summary=sections[kind]?.intro||(kind==='topic'?page.description:kind==='services'?'从明确的业务问题出发，把资料、方法与 AI 连接起来，交付可以检查、可以继续使用的成果。':kind==='cases'?'先看清一套方案如何工作，再讨论它是否适合你的产品与市场。':kind==='contact'?'告诉我们你的产品、目标市场和当前卡点，从值得先验证的环节开始。':kind==='about'?'把经验变成系统，把信息变成有依据的行动。':kind==='search'?'搜索已发布的行业观察、AI 解读与实战指南。':kind==='privacy'?'你提供的信息，用于核对与跟进你主动发起的咨询。':'行业信息、AI 应用与实战方法，从你正在解决的问题开始。')
const route=kind==='topic'?topicRoutes[doc.slug]:undefined,scene=sections[kind]?kind:route?.section||(['services','about'].includes(kind)?'ai':'guides')
const cover=kind==='article'?coverFor(doc):null
const related=kind==='article'?articles.filter(x=>x.id!==doc.id).sort((a,b)=>Number(b.section===doc.section)-Number(a.section===doc.section)).slice(0,3):[]
const sectionGuidance={insights:[['先看市场条件','需求、渠道角色与进入条件分开核对，先确认你的产品面对谁。'],['再看买家样本','从一小组企业开始，判断产品、应用和采购角色是否匹配。'],['把问题带回业务','记录待确认事项，用实际反馈修正判断，不以信息量代替机会。']],ai:[['看懂能力','区分官方发布、编辑解读与实际试跑，先看清工具能做哪一步。'],['放进场景','把搜索、内容、整理与协作放回真实任务，确认输入与限制。'],['留下依据','核对来源、输出和权限，再决定是否投入更多时间与成本。']],guides:[['带一个问题来','选定一个产品、一个市场或一条重复工作，缩小试跑范围。'],['按步骤动手','准备资料、留存来源，把过程整理成下次还可以用的记录。'],['检查结果再继续','对照清楚的验收项复盘，保留有效的方法，也标明未验证的部分。']]}
---
<Layout {...page}>{schema&&<script slot="head" type="application/ld+json" set:html={serializeJsonLd(schema)}/>}
{kind==='home'?<>
 <section class="hero wrap"><div class="hero-copy"><span class="eyebrow"><i></i> 出海的下一步，从这里开始</span><h1>看懂出海机会，<br/>把 <span class="highlight">AI</span> 用进业务<span class="heading-dot">。</span></h1><p class="lead">在变化里找方向，在工具里找方法。<br/>海老板把行业信息、AI 应用与增长服务连接起来，<br class="desktop-only"/>让你的下一步，有依据，也有行动。</p><div class="actions"><a class="button" href="/articles/">探索最新内容 <span>↗</span></a><a class="text-link" href="/services/">了解增长服务 →</a></div><div class="hero-foot"><span>有来源的观察</span><span>可执行的方法</span><span>可检查的交付</span></div></div><div class="hero-visual"><SceneImage scene="insights" eager/><div class="hero-visual-title"><span>GLOBAL BUSINESS. HUMAN + AI.</span><strong>从信息，<br/>到新的可能。</strong></div><div class="signal-float"><span class="signal-icon" aria-hidden="true">✳</span><div><small>INSIGHT → ACTION</small><strong>让 AI 进入真实工作</strong></div><span aria-hidden="true">↗</span></div><div class="orbit-dot" aria-hidden="true"></div></div></section>
 <div class="channel-ribbon wrap">{Object.entries(sections).map(([key,v],i)=><a href={'/'+key+'/'}><span class="ribbon-number">0{i+1}</span><div><strong>{v.title}</strong><small>{v.eyebrow}</small></div><span>↗</span></a>)}</div>
 <section class="wrap section"><div class="section-head"><div><span class="eyebrow">01 / THE EDIT</span><h2>给下一次判断，<br class="mobile-only"/>多一个好视角。</h2></div><a class="text-link" href="/articles/">全部 {articles.length} 篇内容 ↗</a></div>{picks.length?<div class="article-grid">{picks.map((item,i)=><ArticleCard item={item} index={i}/>)}</div>:<p class="empty">正在整理有来源、与出海业务相关的内容。欢迎通过 RSS 关注后续更新。</p>}</section>
 <section class="section section-dark"><div class="wrap"><WorkflowDemo/></div></section>
 <section class="wrap section"><div class="section-head"><div><span class="eyebrow">02 / CONNECT THE DOTS</span><h2>不止一篇文章，<br/>是一条解决问题的路径。</h2></div><p>从信息到方法，再到真实业务。</p></div><div class="topic-grid">{topics.map((item,i)=><a class="topic-card" href={'/topics/'+item.slug+'/'}><span>TOPIC / 0{i+1}</span><h3>{item.title}</h3><p>{item.description}</p><b>沿着这条路径读下去 <span>↗</span></b></a>)}</div></section>
 <section class="section section-tint"><div class="wrap recent-layout"><div><span class="eyebrow">03 / KEEP EXPLORING</span><h2>值得持续关注的，<br/>是与你有关的变化。</h2><p>行业观察、工具解读与实战指南，<br/>按真实发布日期整理。</p><a class="text-link" href="/rss.xml">用 RSS 订阅更新 ↗</a></div><div class="recent-list">{latest.slice(0,5).map(item=><a href={'/articles/'+item.slug+'/'}><time datetime={item.publishedAt}>{date(item.publishedAt)}</time><div><span>{sections[item.section]?.title||'实战指南'}</span><h3>{item.title}</h3></div><b>↗</b></a>)}</div></div></section>
 <section class="wrap section"><div class="section-head"><div><span class="eyebrow">04 / LET'S MAKE IT WORK</span><h2>好方法，也可以一起落地。</h2></div><a class="text-link" href="/services/">服务与交付 ↗</a></div><div class="service-grid">{services.map((item,i)=><a class="service-card" href={'/services/#'+({'buyer-development':'pain-points','content-growth':'ai-growth','ai-workflows':'growth-loop'}[item.slug]||item.slug)}><span class="service-symbol" aria-hidden="true">{['↗','◈','✳'][i%3]}</span><span class="eyebrow">0{i+1} / SERVICE</span><h3>{item.title}</h3><p>{item.description}</p><b>看看适不适合你 ↗</b></a>)}</div></section>
</>:kind==='article'?<>
 <div class="reading-progress" aria-hidden="true"><span></span></div>
 <header class="article-header wrap"><div class="breadcrumbs"><a href="/">首页</a><span>/</span><a href={'/'+(doc.section||'guides')+'/'}>{sections[doc.section]?.title||'实战指南'}</a></div><span class="pill">{types[doc.contentType]||'编辑观察'}</span><h1>{doc.title}</h1><p class="lead">{doc.description}</p><div class="article-byline"><span>{doc.authorName||'海老板编辑部'}</span><time datetime={doc.publishedAt}>发布 {date(doc.publishedAt||doc.createdAt)}</time><span>{Math.max(2,Math.ceil(plain(doc.content?.root).length/400))} 分钟阅读</span><span>{doc.sources?.length||0} 个原始来源</span></div><figure class="article-cover"><img src={cover.src} alt={cover.alt} width="1600" height="914" fetchpriority="high"/><figcaption>{cover.label}</figcaption></figure></header>
 <div class="wrap article-layout"><aside class="article-toc"><details open><summary>本页目录</summary><ol>{headings.map((title,i)=><li><a href={'#section-'+i}>{title}</a></li>)}</ol></details><div class="toc-note"><span class="eyebrow">READ WITH A QUESTION</span><p>这条信息影响谁？<br/>适用条件是什么？<br/>下一步能验证什么？</p></div><a class="toc-contact" href="/contact/">把问题带进你的业务 ↗</a></aside><article class="prose"><div class="article-summary"><span class="eyebrow">IN A NUTSHELL / 先看要点</span><p>{doc.description}</p></div><div set:html={html}/>{doc.sources?.length>0&&<section class="sources"><h2>来源与核查</h2><p>本文含海老板的编辑解读和行动建议。来源所述能力不等于本项目已完成实测；使用前请核对工具或规则的最新状态。</p><ol>{doc.sources.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title} ↗</a>{s.checkedAt&&<small>核查日期：{date(s.checkedAt)}</small>}</li>)}</ol></section>}<div class="article-end"><span class="eyebrow">FROM READING TO DOING</span><h2>把读到的方法，<br/>放回你的具体问题。</h2><p>带上产品、目标市场和当前卡点，我们一起判断值得先做哪一步。</p><a class="button lime" href="/contact/">聊聊你的问题 ↗</a></div></article></div><section class="wrap section"><div class="section-head"><div><span class="eyebrow">KEEP READING</span><h2>把思路，再往前推一步。</h2></div><a href="/articles/" class="text-link">全部内容 ↗</a></div><div class="article-grid">{related.map((item,i)=><ArticleCard item={item} index={i}/>)}</div></section>
</>:<>
 <header class:list={['page-heading','wrap',{'heading-with-scene':!['privacy','search'].includes(kind)}]}><div><div class="breadcrumbs"><a href="/">首页</a><span>/</span><span>{kind==='topic'?'专题阅读':page.title}</span></div><span class="eyebrow">{sections[kind]?.eyebrow||'HAIBOSS / INSIGHT & ACTION'}</span><h1>{page.title}<span class="heading-dot">。</span></h1><p class="lead">{summary}</p>{kind==='ai'&&<a class="text-link" href="#ai-workflows">先看看 AI 如何进入业务 ↓</a>}{kind==='topic'&&<span class="meta-label">{listing.length} 篇相关内容 · 按你的问题开始</span>}</div>{!['privacy','search'].includes(kind)&&<SceneImage scene={scene} eager/>}</header>
 {(sections[kind]||['articles','topic'].includes(kind))&&<>
  {sections[kind]&&<section class="wrap section compact-section"><div class="intro-grid">{sectionGuidance[kind].map(([title,text],i)=><article><span class="eyebrow">0{i+1} / START HERE</span><h2>{title}</h2><p>{text}</p></article>)}</div></section>}
  {kind==='topic'&&route&&<section class="wrap section compact-section"><span class="eyebrow">YOUR READING PATH</span><h2 class="path-title">围绕一个问题，逐步看清楚。</h2><ol class="reading-path">{route.steps.map((step,i)=><li><span>0{i+1}</span><strong>{step}</strong></li>)}</ol><p class="muted small">以下文章按专题归集，可结合自己的阶段选择阅读；这是一条方法路径，并非自动执行的任务。</p></section>}
  <section class="wrap listing" data-content-list><div class="section-head"><div><span class="eyebrow">THE READING ROOM</span><h2>{kind==='topic'?'沿着这条路径，继续读。':kind==='ai'?'AI 的进展，放回业务里看。':'从这些内容开始。'}</h2></div><span class="meta-label">{listing.length} 篇已发布内容</span></div><div class="filter-nav"><a href="/articles/" aria-current={kind==='articles'?'page':undefined}>全部内容</a>{Object.entries(sections).map(([key,v])=><a href={'/'+key+'/'} aria-current={kind===key?'page':undefined}>{v.title}</a>)}</div>{listing.length>0&&<><div class="type-filters" role="group" aria-label="按内容类型筛选"><button type="button" data-filter="all" aria-pressed="true">全部类型</button>{Object.entries(types).filter(([value])=>listing.some(x=>x.contentType===value)).map(([value,label])=><button type="button" data-filter={value} aria-pressed="false">{label}</button>)}<span data-filter-status role="status">{listing.length} 篇内容</span></div><div class="article-grid">{listing.map((item,i)=><ArticleCard item={item} index={i}/>)}</div></>}{!listing.length&&<p class="empty">本栏目正在整理，先读读其他专题。</p>}</section>
  {kind==='ai'&&<><section class="section section-dark" id="ai-workflows"><div class="wrap"><WorkflowDemo/></div></section><section class="wrap section"><WorkflowFilm/></section></>}
  {kind==='guides'&&<section class="wrap section"><WorkflowFilm/></section>}
  <PageExtras kind={kind}/>
  <section class="wrap section compact-section"><div class="subscribe"><div><span class="eyebrow">KEEP A GOOD SIGNAL</span><h3>让有用的信息，有一个持续的入口。</h3><p>通过 RSS 订阅公开文章，或带着具体问题了解增长服务。</p></div><div class="actions"><a class="button outline" href="/rss.xml">订阅更新 ↗</a><a class="text-link" href="/services/">了解服务 →</a></div></div></section>
 </>}
 {['services','cases','about','privacy'].includes(kind)&&<PageExtras kind={kind} services={services} cases={cases}/>}
 {kind==='contact'&&<section class="wrap contact-layout listing"><div class="contact-info"><span class="eyebrow">LET'S TALK BUSINESS</span><h2>从一个具体问题，<br/>开始一段有用的对话。</h2><p>想进入一个新市场、整理内容与独立站，或让 AI 接住一条重复工作？可以先告诉我们你现在卡在哪里。</p><a class="contact-method" href="tel:18805065692"><span>电话联系</span><strong>188 0506 5692 ↗</strong></a>{business?.email&&<a class="contact-method" href={'mailto:'+business.email}><span>邮件联系</span><strong>{business.email} ↗</strong></a>}<div class="prep-note"><h3>这些信息，能让讨论更具体</h3><ul><li>你经营的产品、行业或业务</li><li>目标国家、市场与客户类型</li><li>当前卡点，以及已经尝试过的方法</li><li>希望得到的成果与大致时间安排</li></ul></div><p class="small muted">提交表单后请保存接收编号，便于后续核对。请勿提交密码、验证码或客户机密。</p><a class="text-link" href="/privacy/">查看隐私说明 →</a></div><div class="form-panel"><span class="eyebrow">TELL US ABOUT YOUR CHALLENGE</span><h2>留下你的问题</h2><p class="form-intro">从已有资料开始，暂时不确定的部分可以写“待讨论”。</p><InquiryForm locale="zh"/></div></section>}
 {kind==='search'&&<section class="wrap listing search-area"><form role="search" class="search-form"><label for="content-search">输入产品、市场或工作问题</label><div class="search-input-row"><input id="content-search" type="search" name="q" placeholder="例如：客户开发、AI 搜索、内容更新" autocomplete="off"/><button type="submit" aria-label="搜索公开内容">搜索 ↗</button></div></form><div class="search-suggestions"><span>从这些问题开始</span>{['客户','AI','内容','市场','流程'].map(word=><button type="button" data-query={word}>{word} ↗</button>)}</div><p id="search-status" role="status">输入关键词，搜索本站公开内容。</p><div id="search-results" class="search-results"></div><div id="search-default" class="search-default"><span class="eyebrow">BROWSE BY YOUR QUESTION</span><div class="search-topic-grid">{topics.map(item=><a href={'/topics/'+item.slug+'/'}><h2>{item.title} ↗</h2><p>{item.description}</p></a>)}</div></div><noscript><p>搜索需要浏览器启用 JavaScript，也可以<a href="/articles/">浏览全部文章</a>。</p></noscript><script define:vars={{entries:articles.map(x=>({title:x.title,description:x.description,keywords:[sections[x.section]?.title,types[x.contentType],plain(x.content?.root)].filter(Boolean).join(' '),url:'/articles/'+x.slug+'/'}))}}>const input=document.getElementById('content-search'),results=document.getElementById('search-results'),status=document.getElementById('search-status'),defaults=document.getElementById('search-default');function search(){const query=input.value.trim().toLowerCase(),words=query.split(/\s+/).filter(Boolean),matches=query?entries.filter(x=>words.every(w=>(x.title+' '+x.description+' '+x.keywords).toLowerCase().includes(w))):[];results.replaceChildren();defaults.hidden=Boolean(query);for(const item of matches){const a=document.createElement('a'),h=document.createElement('h2'),p=document.createElement('p');a.href=item.url;h.textContent=item.title+' ↗';p.textContent=item.description;a.append(h,p);results.append(a)}status.textContent=query?(matches.length?'找到 '+matches.length+' 篇相关内容':'暂时没有匹配内容，试试更短的词，例如“客户”或“AI”。'):'输入关键词，搜索本站公开内容。'}input.addEventListener('input',search);document.querySelector('.search-form').addEventListener('submit',e=>{e.preventDefault();search();history.replaceState(null,'',location.pathname+(input.value?'?q='+encodeURIComponent(input.value):''))});document.querySelectorAll('[data-query]').forEach(button=>button.addEventListener('click',()=>{input.value=button.dataset.query;search();input.focus()}));input.value=new URLSearchParams(location.search).get('q')||'';search();</script></section>}
</>}
<script>
 document.querySelectorAll('[data-content-list]').forEach(root=>{
  const cards=root.querySelectorAll<HTMLElement>('[data-content-type]'),buttons=root.querySelectorAll<HTMLButtonElement>('[data-filter]'),status=root.querySelector('[data-filter-status]')
  buttons.forEach(button=>button.addEventListener('click',()=>{let count=0;buttons.forEach(x=>x.setAttribute('aria-pressed',String(x===button)));cards.forEach(card=>{card.hidden=button.dataset.filter!=='all'&&card.dataset.contentType!==button.dataset.filter;if(!card.hidden)count++});if(status)status.textContent=count+' 篇内容'}))
 })
 const progress=document.querySelector<HTMLElement>('.reading-progress span')
 if(progress){let ticking=false;const update=()=>{const body=document.querySelector('article.prose');if(!body)return;const rect=body.getBoundingClientRect(),start=rect.top+scrollY,end=start+rect.height-innerHeight;progress.style.width=Math.max(0,Math.min(100,(scrollY-start)/Math.max(1,end-start)*100))+'%';ticking=false};addEventListener('scroll',()=>{if(!ticking){requestAnimationFrame(update);ticking=true}},{passive:true});addEventListener('resize',update);update()}
</script>
</Layout>
